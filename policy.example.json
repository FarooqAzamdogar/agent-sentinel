{
  "default": "block",
  "tools": {
    "read_file": {
      "action": "allow",
      "deny_args": [
        { "arg": "*", "pattern": "\\.env|\\.ssh|id_rsa|credentials|secrets?" }
      ]
    },
    "fetch_page": "allow",
    "search_*": "allow",
    "send_email": {
      "action": "ask",
      "allow_args": [
        { "arg": "to", "pattern": "[^@\\s,;]+@example\\.com" }
      ]
    },
    "delete_*": "block",
    "run_shell": "block",
    "resources/read": {
      "action": "allow",
      "deny_args": [
        { "arg": "uri", "pattern": "\\.env|\\.ssh|id_rsa|credentials|secrets?" }
      ]
    }
  },
  "injection": {
    "block_severity": "high"
  }
}
