{
  "default": "block",
  "hide_blocked_tools": true,
  "deny_args": [
    { "arg": "*", "pattern": "(^|[\\s\\\\/:@='\\\"`<>|;&(,{\\u2018-\\u201e])\\.(ssh|aws|azure|docker|gnupg|kube|env|netrc|npmrc|pypirc|pgpass|git-credentials)\\b(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|id_(rsa|dsa|ecdsa|ed25519)(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|(^|[\\s\\\\/:@='\\\"`<>|;&(,{\\u2018-\\u201e])(ssh|aws|azure|docker|gnupg|kube|env|netrc|npmrc|pypirc|pgpass|git-cr|id_ed2)~[0-9](?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|(^|[\\s\\\\/:@='\\\"`<>|;&(,{\\u2018-\\u201e])(\\.config|config~[0-9]+)[\\\\/](gh|gcloud|github-copilot)\\b(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|(^|[\\\\/])proc[\\\\/][^\\\\/]+[\\\\/]environ\\b(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|claude_desktop_config\\.json(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|(^|[\\s\\\\/:@='\\\"`<>|;&(,{\\u2018-\\u201e])\\.claude\\.json\\b(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|(^|[\\s\\\\/:@='\\\"`<>|;&(,{\\u2018-\\u201e])\\.(cursor|vscode)[\\\\/]mcp\\.json\\b(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))|[\\\\/]code[\\\\/]user[\\\\/]mcp\\.json\\b(?!\\.(example|sample|template|dist)(?=$|[\\s'\\\"`<>|;&,)}\\]\\u2018-\\u201e]))" }
  ],
  "tools": {
    "read_file": { "action": "allow", "labels": ["private"] },
    "fetch_page": { "action": "allow", "labels": ["untrusted", "sink"] },
    "search_*": { "action": "allow", "labels": ["untrusted", "sink"] },
    "send_email": {
      "action": "ask",
      "labels": ["sink"],
      "allow_args": [
        { "arg": "to", "type": "email", "domains": ["example.com"] },
        { "arg": "cc", "type": "email", "domains": ["example.com"], "optional": true },
        { "arg": "bcc", "type": "email", "domains": ["example.com"], "optional": true },
        { "arg": "subject", "pattern": "(?s).*", "optional": true },
        { "arg": "body", "pattern": "(?s).*", "optional": true }
      ],
      "other_args": "block",
      "max_calls_per_minute": 5
    },
    "delete_*": "block",
    "run_shell": "block",
    "resources/read": { "action": "allow", "labels": ["untrusted", "private"] }
  },
  "flows": [
    { "after": ["untrusted", "private"], "then": "sink", "action": "block" }
  ],
  "server_requests": {
    "sampling/createMessage": "block",
    "*": "allow"
  },
  "injection": {
    "block_severity": "high"
  },
  "secrets": {
    "in_arguments": "block",
    "in_results": "redact",
    "canaries": ["sentinel-canary-5d81e2"],
    "patterns": [
      { "name": "Example Corp token", "prefix": "exc_", "charset": "alnum", "min_len": 32, "max_len": 40 }
    ]
  },
  "limits": {
    "max_calls_per_minute": 120
  }
}
