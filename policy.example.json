{
  "default": "block",
  "deny_args": [
    { "arg": "*", "pattern": "(^|[\\\\/:])\\.(ssh|aws|azure|docker|gnupg|kube|env|netrc|npmrc|pypirc|pgpass|git-credentials)\\b|id_(rsa|dsa|ecdsa|ed25519)|(^|[\\\\/:])(ssh|aws|azure|docker|gnupg|kube|env|netrc|npmrc|pypirc|pgpass|git-cr|id_ed2)~[0-9]|(^|[\\\\/:])(\\.config|config~[0-9]+)[\\\\/](gh|gcloud|github-copilot)\\b|(^|[\\\\/])proc[\\\\/][^\\\\/]+[\\\\/]environ\\b|claude_desktop_config\\.json|(^|[\\\\/:])\\.claude\\.json\\b|(^|[\\\\/:])\\.(cursor|vscode)[\\\\/]mcp\\.json\\b|[\\\\/]code[\\\\/]user[\\\\/]mcp\\.json\\b" }
  ],
  "tools": {
    "read_file": "allow",
    "fetch_page": "allow",
    "search_*": "allow",
    "send_email": {
      "action": "ask",
      "allow_args": [
        { "arg": "to", "pattern": "[^@\\s,;]+@example\\.com" },
        { "arg": "cc", "pattern": "[^@\\s,;]+@example\\.com", "optional": true },
        { "arg": "bcc", "pattern": "[^@\\s,;]+@example\\.com", "optional": true },
        { "arg": "subject", "pattern": "(?s).*", "optional": true },
        { "arg": "body", "pattern": "(?s).*", "optional": true }
      ],
      "other_args": "block",
      "max_calls_per_minute": 5
    },
    "delete_*": "block",
    "run_shell": "block",
    "resources/read": "allow"
  },
  "server_requests": {
    "sampling/createMessage": "block",
    "*": "allow"
  },
  "injection": {
    "block_severity": "high"
  },
  "secrets": {
    "in_arguments": "block"
  },
  "limits": {
    "max_calls_per_minute": 120
  }
}
